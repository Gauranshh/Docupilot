# ============ Required ============
PINECONE_API_KEY=your-pinecone-key

# Pick ONE provider. With only GOOGLE_API_KEY set, Gemini models are used automatically.
GOOGLE_API_KEY=your-gemini-key
# OPENAI_API_KEY=your-openai-key

# ============ Models (optional — sensible defaults per provider) ============
# Gemini (free tier): https://aistudio.google.com/apikey
LLM_MODEL=google_genai:gemini-3.8-flash
GRADER_MODEL=google_genai:gemini-3.8-flash
EMBEDDING_MODEL=google_genai:models/gemini-embedding-001
# OpenAI:
# LLM_MODEL=openai:gpt-4.1-mini
# GRADER_MODEL=openai:gpt-4.1-mini
# EMBEDDING_MODEL=openai:text-embedding-3-small

# ============ Pinecone ============
# Use a different index name per embedding model (dimensions differ).
PINECONE_INDEX=docupilot-gemini
PINECONE_NAMESPACE=handbook
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ============ Retrieval ============
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
FETCH_K=20
TOP_K=5
RERANK=true
RERANK_MODEL=bge-reranker-v2-m3
# Keyword (BM25) + vector search fused with Reciprocal Rank Fusion
HYBRID_SEARCH=true
# Merge short slide pages before chunking (re-ingest after changing)
MERGE_SHORT_PAGES=true
# Read pages that are mostly pictures with the AI model (1 call per page, at ingest)
DESCRIBE_IMAGES=false
VISION_MIN_CHARS=80
VISION_MAX_PAGES=40

# ============ Agent ============
MAX_REWRITES=2
MAX_GENERATION_RETRIES=1
FULL_DOC_CHAR_LIMIT=300000

# ============ Cost controls (free tiers can be ~20 requests/day per model) ============
# 1 LLM call per file at ingest; set false to save quota
SUMMARIZE_ON_INGEST=true
# 'summarize…', 'how many…', 'hi' skip the router LLM call
KEYWORD_ROUTING=true
# Self-RAG grounding check (+1 call per answer)
VERIFY_ANSWERS=true
# Verifying whole-document answers resends the whole document
VERIFY_DOCUMENT_ANSWERS=false
# Trained question router (models/router.joblib); below this confidence the LLM router decides
TRAINED_ROUTER=true
ROUTER_MIN_CONFIDENCE=0.7
# Save the LLM router's decisions as new training examples when the trained router is unsure
ROUTER_LEARNING=true
# Reuse answers to repeated questions (cleared automatically when documents change)
ANSWER_CACHE=true
CACHE_TTL_HOURS=168
# Tip: use a cheaper/higher-quota model for the judge steps, e.g. a Flash-Lite model:
# GRADER_MODEL=google_genai:<flash-lite model id from AI Studio>

# ============ Optional: web fallback (https://tavily.com) ============
# TAVILY_API_KEY=your-tavily-key
WEB_FALLBACK=true

# ============ Optional: LangSmith tracing (https://smith.langchain.com) ============
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_PROJECT=docupilot
